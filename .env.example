# Copy this file to .env and fill it in. Never commit .env.

# Your district's Skyward Family Access login page URL
SKYWARD_URL=https://skyward.iscorp.com/scripts/wsisa.dll/WService=wseduprospertx/fwemnu01.w # This is for Prosper ISD, TX. Change it to your district's URL.
SKYWARD_USERNAME=
SKYWARD_PASSWORD=

# When to run (cron format: minute hour day month weekday) and in which time zone
SCHEDULE_CRON=0 15 * * *
TZ=America/Chicago

# Also run once immediately when the container starts (true/false)
RUN_ON_START=false

# Keep a copy of the raw gradebook HTML each run (helps fix the parser if Skyward changes)
SAVE_RAW_HTML=true

# Also read assignment details (opens each course's latest term grade) and save
# assignments_*.csv. Seconds to pause between courses, to go easy on the server.
FETCH_ASSIGNMENTS=true
ASSIGNMENT_DELAY_SECONDS=1.5

# Where CSVs are written inside the container (mapped to ./data by docker compose)
DATA_DIR=/app/data

# Retries if a run fails (e.g. Skyward is down), and minutes between them
MAX_RETRIES=2
RETRY_DELAY_MINUTES=10

LOG_LEVEL=INFO

# Family dashboard. Plain rules, no AI.
# HTTP_PORT: direct port on this computer for `docker compose up` (a backup address,
# http://<mac-ip>:8787). Port 80 belongs to the shared home server (../home-server),
# which sends http://kids-dashboard.local here.
HTTP_PORT=8787
# DASHBOARD_PORT: port for `./start.sh serve` when running without Docker.
DASHBOARD_PORT=8787
# Kids mode is the front page. The grown-up view needs this 4-digit PIN (the page's
# keypad takes exactly 4 digits). If it's blank the PIN is 1234, so set your own.
DASH_PARENT_PIN=
# Lowest creature mood per child: "hungry" or "sleepy" (never sad). Blank = hungry for
# 5th grade and below, sleepy for older kids. Example: Dithya=hungry,Manya=sleepy
KIDS_MOODS=
# The creature arrows compare with the grades about this many days ago
DASH_TREND_DAYS=7
# Alert thresholds (leave blank for the defaults shown)
DASH_FAILING_BELOW=70
DASH_WATCH_BELOW=80
DASH_STRONG_AT=90
DASH_DROP_POINTS=10
DASH_GAP_POINTS=10

# Daily family text alert (sent from the Mac by deploy/send-alerts.sh; see docs/MAC_MINI_SETUP.md)
# How many days ahead to warn about work with no score, and the link at the end.
ALERT_DUE_DAYS=2
ALERT_LINK=https://kids-dashboard.local
