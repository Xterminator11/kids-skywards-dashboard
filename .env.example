# Copy this file to .env and fill it in. Never commit .env.

# Your district's Skyward Family Access login page URL
SKYWARD_URL=https://skyward.iscorp.com/scripts/wsisa.dll/WService=wseduprospertx/fwemnu01.w
SKYWARD_USERNAME=
SKYWARD_PASSWORD=

# When to run (cron format: minute hour day month weekday) and in which time zone
SCHEDULE_CRON=0 15 * * *
TZ=America/Chicago

# Also run once immediately when the container starts (true/false)
RUN_ON_START=false

# Keep a copy of the raw gradebook HTML each run (helps fix the parser if Skyward changes)
SAVE_RAW_HTML=true

# Also read assignment details (opens each course's latest term grade) and save
# assignments_*.csv. Seconds to pause between courses, to go easy on the server.
FETCH_ASSIGNMENTS=true
ASSIGNMENT_DELAY_SECONDS=1.5

# Where CSVs are written inside the container (mapped to ./data by docker compose)
DATA_DIR=/app/data

# Retries if a run fails (e.g. Skyward is down), and minutes between them
MAX_RETRIES=2
RETRY_DELAY_MINUTES=10

LOG_LEVEL=INFO

# Family dashboard. Plain rules, no AI.
# HTTP_PORT: port on this computer for `docker compose up` (80 = no port in the address).
HTTP_PORT=80
# DASHBOARD_PORT: port for `./start.sh serve` when running without Docker.
DASHBOARD_PORT=8787
# Alert thresholds (leave blank for the defaults shown)
DASH_FAILING_BELOW=70
DASH_WATCH_BELOW=80
DASH_STRONG_AT=90
DASH_DROP_POINTS=10
DASH_GAP_POINTS=10

# Daily family text alert (sent from the Mac by deploy/send-alerts.sh; see docs/MAC_MINI_SETUP.md)
# How many days ahead to warn about work with no score, and the link at the end.
ALERT_DUE_DAYS=2
ALERT_LINK=http://kids-dashboard.local
